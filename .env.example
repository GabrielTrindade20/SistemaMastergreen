# ===== Banco de dados =====
# No EasyPanel, copie a "Connection URL" interna do servico Postgres.
# Formato: postgres://usuario:senha@<projeto>_<servico>:5432/banco
DATABASE_URL=postgres://usuario:senha@mastergreen_db:5432/mastergreen

# SSL do Postgres:
#   - Postgres interno do EasyPanel/Docker: deixe "false" (rede privada, sem SSL)
#   - Neon/Supabase ou conexao externa: use "true"
PGSSL=false

# ===== Aplicacao =====
NODE_ENV=production

# Porta que o app escuta dentro do container (aponte o proxy do EasyPanel pra ela).
PORT=5000

# Chave secreta das sessoes (gere uma aleatoria, ex.: openssl rand -hex 32)
SESSION_SECRET=troque_por_uma_chave_aleatoria_longa

# ----- Exemplos de outros provedores (caso um dia troque) -----
# Neon:     DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require  (PGSSL=true)
# Supabase: DATABASE_URL=postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres          (PGSSL=true)
